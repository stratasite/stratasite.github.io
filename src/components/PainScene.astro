---
/**
 * "Sound familiar?" as one moving picture instead of three cards.
 *
 * A stage in three equal columns, so it lines up under the three numbered
 * sentences the page puts above it:
 *   1. a queue of business users, each with a question;
 *   2. the BI tools they already have, each with an AI chat bolted on the
 *      side. One user at a time walks up and asks. The chat answers inside
 *      the tool, in its own voice, with the roadblock it really gives: it
 *      cannot get the formula right, the blend does not exist, the source
 *      was never connected. The user is marked with a cross and walks off
 *      grey;
 *   3. the data team, where every bounced user ends up as a ticket on a pile
 *      that never gets shorter. The backlog counter only goes up.
 *
 * Three actors run the same loop out of phase, one per tool, so the stage
 * is never still. Drawn in SVG with CSS keyframes and semantic tokens only,
 * so it holds on any theme. Under prefers-reduced-motion the loop stops on
 * a frame that still tells the story: every actor parked at its tool,
 * every reply showing, the pile full.
 *
 * Tool names and marks are the incumbents the buyer has, drawn in one
 * muted colour so they read as "the tools", not as a logo wall. Looker's
 * mark is the simple-icons path (CC0); Power BI and Tableau are not in that
 * set, so their marks are drawn here as plain geometry. Their chat features
 * are not named, only drawn, so nothing here needs re-verifying per release.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const tools = [
  { name: 'Power BI', mark: 'powerbi', cy: 84, ask: 'revenue by region, this quarter?', reply: 'My DAX filter context is wrong.' },
  { name: 'Tableau', mark: 'tableau', cy: 196, ask: 'tickets per customer, by plan?', reply: "I can't blend Tickets to Customers." },
  { name: 'Looker', mark: 'looker', cy: 308, ask: 'churn against last year?', reply: "I don't have a Subscriptions source." },
];

// Stage geometry (viewBox 1000 x 420). Three columns centred at 167, 500
// and 833, matching a three column grid above.
const box = { x: 360, w: 280, h: 80 };
const tab = { w: 108, h: 26 };
const queue = [75, 121, 167, 213, 259];
const pile = [352, 332, 312, 292, 272, 252]; // static ticket tops, bottom up
const landing = [232, 212, 192]; // where each actor's ticket lands
const team = { cx: 833, deskX: 758, pileX: 785 };
const labelY = 410;
const floorY = 382;
const loop = 10; // seconds per actor cycle; actors are spaced a third apart
---

<figure class={`pain-scene ${className}`} aria-label="Business users queue for Power BI, Tableau and Looker, ask the AI chat bolted onto each tool, get a roadblock back, and end up as tickets on an overloaded data team's pile">
  <svg viewBox="0 0 1000 420" class="block h-auto w-full" role="img" aria-hidden="true">
    <defs>
      <!-- A person: head and shoulders, drawn once. -->
      <g id="person">
        <circle cx="0" cy="-18" r="9" />
        <rect x="-11" y="-6" width="22" height="28" rx="9" />
      </g>
      <!-- A bolt: the hex nut that says "attached later". -->
      <g id="nut">
        <path d="M0 -6.5 5.6 -3.25V3.25L0 6.5 -5.6 3.25V-3.25Z" />
        <circle cx="0" cy="0" r="2.2" class="nut-hole" />
      </g>
      <!-- The chat's sparkle. -->
      <path id="spark" d="M0 -6 l1.6 4.4 4.4 1.6 -4.4 1.6 -1.6 4.4 -1.6 -4.4 -4.4 -1.6 4.4 -1.6z" />
      <!-- The tools' marks, monochrome. -->
      <symbol id="mark-powerbi" viewBox="0 0 24 24">
        <rect x="2.5" y="13" width="5.5" height="10" rx="1.4" />
        <rect x="9.25" y="7" width="5.5" height="16" rx="1.4" />
        <rect x="16" y="1" width="5.5" height="22" rx="1.4" />
      </symbol>
      <symbol id="mark-tableau" viewBox="0 0 24 24">
        <path d="M11 5h2v14h-2zM5 11h14v2H5z" />
        <path d="M11.4 0h1.2v4.6h-1.2zM9.5 1.7h5v1.2h-5zM11.4 19.4h1.2V24h-1.2zM9.5 21.1h5v1.2h-5zM0 11.4h4.6v1.2H0zM1.7 9.5h1.2v5H1.7zM19.4 11.4H24v1.2h-4.6zM21.1 9.5h1.2v5h-1.2z" />
        <path d="M4 3.2h.9v2.6H4zM3.15 4.05h2.6v.9h-2.6zM19.1 3.2h.9v2.6h-.9zM18.25 4.05h2.6v.9h-2.6zM4 18.2h.9v2.6H4zM3.15 19.05h2.6v.9h-2.6zM19.1 18.2h.9v2.6h-.9zM18.25 19.05h2.6v.9h-2.6z" />
      </symbol>
      <symbol id="mark-looker" viewBox="0 0 24 24">
        <path d="M11.9475 0c-1.1598.0021-2.0982.944-2.096 2.1038a2.1 2.1 0 00.356 1.166l.895-.8959a.884.884 0 11.565.564l-.895.895c.9593.6478 2.2621.3953 2.91-.564.6478-.9593.3953-2.262-.564-2.91A2.096 2.096 0 0011.9475 0zm-.835 6.1128a3.2629 3.2629 0 00-.653-1.965l-1.164 1.162a1.667 1.667 0 01-.318 2.012l.632 1.5449a3.2819 3.2819 0 001.503-2.754zm-3.2499 1.666h-.03c-.9217.0009-1.6697-.7455-1.6707-1.6673-.001-.9217.7454-1.6697 1.6672-1.6707a1.669 1.669 0 01.9195.275l1.152-1.152c-1.4069-1.141-3.4724-.9257-4.6135.4811s-.9257 3.4723.481 4.6135a3.2799 3.2799 0 002.7275.6652l-.633-1.5439v-.001zm4.1279 1.3359c-.728 0-1.452.106-2.15.315l.922 2.2519c2.6872-.6819 5.4184.9438 6.1002 3.631.6818 2.6873-.9439 5.4184-3.6311 6.1002s-5.4184-.9439-6.1002-3.631c-.5682-2.2394.4655-4.5774 2.5041-5.6643l-.91-2.2449c-3.6908 1.808-5.2173 6.2657-3.4093 9.9567l.0005.001c1.808 3.6909 6.2657 5.2173 9.9567 3.4093l.001-.0005c3.6913-1.8071 5.2187-6.2645 3.4116-9.9558a7.4417 7.4417 0 00-6.6865-4.1696h-.008l-.001.001z" />
      </symbol>
    </defs>

    <!-- 1. The queue -->
    <g class="scene-queue">
      {queue.map((x) => <use href="#person" x={x} y="200" class="person-muted" />)}
      <text x="167" y={labelY} text-anchor="middle" class="scene-label"><tspan class="scene-num">1</tspan>  the business</text>
    </g>

    <!-- 2. The tools, each with an AI chat bolted on, answering inside the box -->
    {tools.map((tl, i) => (
      <g class="scene-tool">
        <rect x={box.x} y={tl.cy - box.h / 2} width={box.w} height={box.h} rx="10" class="tool-box" />
        <use href={`#mark-${tl.mark}`} x={box.x + 18} y={tl.cy - 28} width="24" height="24" class="tool-mark" />
        <text x={box.x + 52} y={tl.cy - 9} class="tool-name">{tl.name}</text>
        <!-- the bolt-on: a tab hung off the box's top right, a nut at each end -->
        <g>
          <rect x={box.x + box.w - tab.w - 8} y={tl.cy - box.h / 2 - 10} width={tab.w} height={tab.h} rx="7" class="chat-tab" />
          <use href="#nut" x={box.x + box.w - tab.w - 8 + 9} y={tl.cy - box.h / 2 + 3} class="nut" />
          <use href="#nut" x={box.x + box.w - 8 - 9} y={tl.cy - box.h / 2 + 3} class="nut" />
          <use href="#spark" x={box.x + box.w - tab.w - 8 + 24} y={tl.cy - box.h / 2 + 3} class="chat-spark" />
          <text x={box.x + box.w - tab.w - 8 + 62} y={tl.cy - box.h / 2 + 7} text-anchor="middle" class="chat-label">AI chat</text>
        </g>
        <!-- the chat's reply, in its own voice, where a chat reply sits -->
        <g class={`reply reply-${i}`} style={`--delay: ${(i * loop) / 3}s`}>
          <use href="#spark" x={box.x + 24} y={tl.cy + 18} class="reply-spark" />
          <text x={box.x + 40} y={tl.cy + 22} class="reply-text">{tl.reply}</text>
        </g>
      </g>
    ))}
    <text x="500" y={labelY} text-anchor="middle" class="scene-label"><tspan class="scene-num">2</tspan>  the BI tool you have, with an AI chat bolted on</text>

    <!-- 3. The data team and the pile -->
    <g class="scene-team">
      <g transform={`translate(${team.cx - 27} 140)`}><g class="engineer engineer-a"><use href="#person" class="person-muted" /></g></g>
      <g transform={`translate(${team.cx + 27} 140)`}><g class="engineer engineer-b"><use href="#person" class="person-muted" /></g></g>
      <rect x={team.deskX} y="150" width="150" height="8" rx="4" class="desk" />
      <!-- the alarm over their heads -->
      <g class="alarm">
        <circle cx={team.cx} cy="96" r="10" class="alarm-dot" />
        <text x={team.cx} y="101" text-anchor="middle" class="alarm-mark">!</text>
      </g>
      {pile.map((top) => <rect x={team.pileX} y={top} width="96" height="16" rx="3" class="ticket" />)}
      {landing.map((top, i) => <rect x={team.pileX} y={top} width="96" height="16" rx="3" class={`ticket ticket-land ticket-land-${i}`} />)}
      <text x={team.cx} y={labelY} text-anchor="middle" class="scene-label"><tspan class="scene-num">3</tspan>  the data team</text>
      <g class="backlog">
        <rect x={team.cx - 64} y="30" width="128" height="26" rx="13" class="backlog-pill" />
        <text x={team.cx} y="47" text-anchor="middle" class="backlog-text">backlog <tspan class="backlog-count" data-backlog>47</tspan></text>
      </g>
    </g>

    <!-- The floor the bounced users take to the pile. -->
    <path d={`M${box.x + 20} ${floorY} H ${team.deskX}`} class="route" />

    <!-- The actors: one per tool, same loop, a third apart. -->
    {tools.map((tl, i) => (
      <g class={`actor actor-${i}`} style={`--cy: ${tl.cy}px; --delay: ${(i * loop) / 3}s`}>
        <use href="#person" class="person-actor" />
        <!-- the question, held up while asking -->
        <g class="ask">
          <rect x="-254" y="-60" width="236" height="26" rx="8" class="ask-box" />
          <text x="-136" y="-43" text-anchor="middle" class="ask-text">{tl.ask}</text>
        </g>
        <!-- the cross: bounced -->
        <g class="fail">
          <circle cx="13" cy="-27" r="7.5" class="fail-dot" />
          <path d="M10 -30 l6 6 M16 -30 l-6 6" class="fail-x" />
        </g>
      </g>
    ))}
  </svg>
  <figcaption class="sr-only">
    Business users wait in a queue. Each walks up to Power BI, Tableau or Looker and asks the AI chat bolted onto
    the tool. The chat replies that it cannot get the DAX filter context right, cannot blend Tickets to Customers,
    or has no Subscriptions source. The user is marked with a cross, walks off, and ends up as a ticket on the data
    team's pile, and the backlog counter keeps climbing.
  </figcaption>
</figure>

<script>
  // The backlog only goes up: one more ticket each time an actor lands on
  // the pile. Purely decorative, so it stops when the page is hidden.
  const count = document.querySelector<SVGElement>('[data-backlog]');
  if (count && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let n = 47;
    const period = (10 / 3) * 1000; // one landing per third of the actor loop
    const tick = () => {
      if (document.hidden) return;
      n += 1;
      count.textContent = String(n);
    };
    // First landing happens at 58% of the first actor's cycle.
    window.setTimeout(() => {
      tick();
      window.setInterval(tick, period);
    }, 0.58 * 10 * 1000);
  }
</script>

<style>
  /* People */
  .person-muted {
    fill: color-mix(in srgb, var(--muted-foreground) 55%, var(--surface-2));
  }
  .person-actor {
    fill: var(--primary);
  }

  /* Tools */
  .tool-box {
    fill: var(--surface);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .tool-mark {
    fill: var(--muted-foreground);
  }
  .tool-name {
    fill: var(--foreground);
    font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: 19px;
  }
  .chat-tab {
    fill: var(--surface-2);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .chat-label {
    fill: var(--muted-foreground);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .nut,
  .chat-spark {
    fill: var(--muted-foreground);
  }
  .nut-hole {
    fill: var(--surface-2);
  }

  /* The question, and the chat's reply */
  .ask-box {
    fill: var(--surface-2);
    stroke: color-mix(in srgb, var(--primary) 55%, var(--border));
    stroke-width: 1.2;
  }
  .ask-text {
    fill: var(--foreground);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
  }
  .reply-spark {
    fill: var(--primary);
  }
  .reply-text {
    fill: var(--foreground);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
  }

  /* The cross on a bounced user */
  .fail-dot {
    fill: var(--surface-2);
    stroke: var(--primary);
    stroke-width: 1.5;
  }
  .fail-x {
    stroke: var(--primary);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  /* The data team */
  .desk {
    fill: var(--border);
  }
  .ticket {
    fill: var(--surface-2);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .alarm-dot {
    fill: var(--primary);
  }
  .alarm-mark {
    fill: var(--background);
    font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: 14px;
  }
  .backlog-pill {
    fill: var(--surface);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .backlog-text {
    fill: var(--muted-foreground);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .backlog-count {
    fill: var(--foreground);
    font-weight: 700;
  }
  .scene-num {
    fill: var(--primary);
    font-weight: 700;
  }
  .scene-label {
    fill: var(--muted-foreground);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .route {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.5;
    stroke-dasharray: 4 6;
  }

  /* Motion. Each actor: leave the queue, stand at its tool, ask, get the
     reply, take the cross, walk off grey along the floor to the pile, become
     a ticket, fade, and start over. All three run the same ten second loop
     a third apart. */
  .actor,
  .actor .ask,
  .actor .fail,
  .actor .person-actor,
  .reply {
    animation-duration: 10s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
    animation-delay: var(--delay);
  }
  .actor {
    animation-name: walk;
    transform: translate(259px, 200px);
  }
  .actor .ask {
    animation-name: ask;
    opacity: 0;
  }
  .actor .fail {
    animation-name: fail;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .actor .person-actor {
    animation-name: grey-out;
  }
  .reply {
    animation-name: reply;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: left center;
  }
  /* The three landing slots stack up over the loop (one lands per actor)
     and clear together just before the first lands again, so the pile is
     always at least as tall as the static stack and usually taller. */
  .ticket-land {
    animation-duration: 10s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-out;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .ticket-land-0 { animation-name: land-0; }
  .ticket-land-1 { animation-name: land-1; }
  .ticket-land-2 { animation-name: land-2; }
  .engineer {
    transform-box: fill-box;
    transform-origin: center bottom;
    animation: fret 0.7s ease-in-out infinite alternate;
  }
  .engineer-b {
    animation-delay: 0.35s;
  }
  .alarm {
    transform-box: fill-box;
    transform-origin: center;
    animation: alarm 1.2s ease-in-out infinite;
  }

  @keyframes walk {
    0%   { transform: translate(259px, 200px); opacity: 0; }
    4%   { opacity: 1; }
    16%  { transform: translate(346px, var(--cy)); }
    40%  { transform: translate(346px, var(--cy)); }
    45%  { transform: translate(346px, 376px); }
    56%  { transform: translate(745px, 376px); opacity: 1; }
    60%  { transform: translate(775px, 364px); opacity: 0; }
    100% { transform: translate(259px, 200px); opacity: 0; }
  }
  @keyframes ask {
    0%, 17% { opacity: 0; }
    20%, 29% { opacity: 1; }
    32%, 100% { opacity: 0; }
  }
  @keyframes reply {
    0%, 29% { opacity: 0; transform: translateX(-6px); }
    31% { opacity: 1; transform: translateX(3px); }
    33% { transform: translateX(-2px); }
    35% { transform: translateX(0); }
    47% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  @keyframes fail {
    0%, 32% { opacity: 0; transform: scale(0.4); }
    35% { opacity: 1; transform: scale(1.15); }
    37%, 58% { opacity: 1; transform: scale(1); }
    61%, 100% { opacity: 0; transform: scale(1); }
  }
  @keyframes grey-out {
    0%, 38% { fill: var(--primary); }
    46%, 100% { fill: color-mix(in srgb, var(--muted-foreground) 55%, var(--surface-2)); }
  }
  /* Actor 0 lands at 60%, actor 1 at 93.3%, actor 2 at 26.7% (its cycle
     wraps); everything clears at 58%. */
  @keyframes land-0 {
    0%, 57% { opacity: 1; transform: none; }
    58%, 59% { opacity: 0; transform: translateY(-14px) scale(1.05); }
    61%, 100% { opacity: 1; transform: none; }
  }
  @keyframes land-1 {
    0%, 57% { opacity: 1; transform: none; }
    58%, 92% { opacity: 0; transform: translateY(-14px) scale(1.05); }
    94%, 100% { opacity: 1; transform: none; }
  }
  @keyframes land-2 {
    0%, 25% { opacity: 0; transform: translateY(-14px) scale(1.05); }
    27%, 57% { opacity: 1; transform: none; }
    58%, 100% { opacity: 0; transform: translateY(-14px) scale(1.05); }
  }
  @keyframes fret {
    from { transform: rotate(-3deg); }
    to { transform: rotate(3deg); }
  }
  @keyframes alarm {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.18); opacity: 0.75; }
  }

  /* No motion: one frame that still tells the story. */
  @media (prefers-reduced-motion: reduce) {
    .actor,
    .actor .ask,
    .actor .fail,
    .actor .person-actor,
    .reply,
    .ticket-land,
    .engineer,
    .alarm {
      animation: none;
    }
    .actor {
      transform: translate(346px, var(--cy));
      opacity: 1;
    }
    .actor .ask,
    .actor .fail,
    .reply,
    .ticket-land {
      opacity: 1;
      transform: none;
    }
  }
</style>
