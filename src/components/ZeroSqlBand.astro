---
/**
 * The open source option: 0sql, the semantic layer inside Strata, published
 * on its own at 0sql.io under MIT. Mirrors the Strata callout on 0sql.io in
 * the other direction: a free, self-hosted path for a visitor who only needs
 * the planner and the SQL it returns. Every link is a followed link to
 * 0sql.io with "0sql" in the anchor text, which is what ties the brand term
 * to that domain in search.
 *
 * Placement: home after the case study, pricing under the tiers, Try under
 * the two Strata paths, the semantic layer product page before the live
 * demo. `body` carries the one page-specific sentence.
 *
 * Peach outline, not a rust band: the page's one rust surface is already
 * spent. The 0sql mark in public/vendor/0sql/ is 0sql's own, copied
 * unmodified: use it as published, do not recolour it. The paper knockout
 * version sits in the rust button, where the badge itself may not go.
 */
import { site } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  /** `cta_location` on the zerosql_click event, e.g. `home-band`, `pricing-band`. */
  location: string;
  /** One page-specific sentence after the description. */
  body?: string;
  heading?: string;
  class?: string;
}
const {
  location,
  heading = 'Only need the query layer? Run 0sql, free.',
  body = 'Building your own product? Take 0sql. Want the product? Strata is the same planner with execution, dashboards, self-service and agents around it.',
  class: className = '',
} = Astro.props;
const z = site.zerosql;

const btn =
  'cta inline-flex items-center justify-center gap-2 rounded-sm px-6 py-3 font-display font-bold uppercase tracking-wide no-underline shadow-sm transition-[box-shadow,transform,filter] duration-200 hover:-translate-y-0.5 hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';
const primary = `${btn} bg-cta text-cta-foreground hover:brightness-105`;
const ghost = `${btn} border border-primary bg-transparent text-foreground hover:bg-primary/10`;
---

<section class={`border-t border-border bg-surface-2 ${className}`}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 rounded-2xl border border-border bg-surface p-8 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:items-center lg:p-10">
      <div>
        <div class="flex items-center gap-2.5 text-primary">
          <Icon name="github" class="h-5 w-5 shrink-0" />
          <p class="font-display text-sm font-semibold uppercase tracking-wider">Open source, {z.license} licensed</p>
        </div>
        <h2 class="mt-4 font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">{heading}</h2>
        <p class="mt-3 max-w-2xl text-muted-foreground">
          <a
            href={z.url}
            target="_blank"
            rel="noopener"
            class="font-semibold text-primary hover:underline"
            data-track="zerosql_click"
            data-track-cta-location={location}
            data-track-target="site"
          >0sql</a>
          is the open source semantic layer Strata runs on. Model your warehouse in YAML, run
          the server, POST a query spec, get back correct SQL. No seats, no account. Same model format as Strata.
        </p>
        <p class="mt-3 max-w-2xl text-muted-foreground">{body}</p>
        <div class="mt-7 flex flex-wrap items-center gap-4">
          <a
            href={z.url}
            target="_blank"
            rel="noopener"
            class={primary}
            data-track="zerosql_click"
            data-track-cta-location={location}
            data-track-target="site"
          >
            <img src="/vendor/0sql/0sql_icon_mono_paper.svg" alt="" aria-hidden="true" class="h-5 w-5" />
            Get 0sql
          </a>
          <a
            href={z.repoUrl}
            target="_blank"
            rel="noopener"
            class={ghost}
            data-track="zerosql_click"
            data-track-cta-location={location}
            data-track-target="repo"
          >
            <Icon name="github" class="h-5 w-5" />
            GitHub
          </a>
          <a
            href={z.docsUrl}
            target="_blank"
            rel="noopener"
            class={ghost}
            data-track="zerosql_click"
            data-track-cta-location={location}
            data-track-target="docs"
          >
            <Icon name="book" class="h-5 w-5" />
            Read the docs
          </a>
        </div>
      </div>

      <!-- One line to a running server. -->
      <div class="overflow-hidden rounded-xl border border-border">
        <div class="flex items-center gap-2 border-b border-border bg-surface-2 px-4 py-2.5 font-mono text-xs text-muted-foreground">
          <span class="h-2 w-2 rounded-full bg-primary/70" aria-hidden="true"></span>
          terminal
        </div>
        <pre class="overflow-x-auto bg-code-surface px-4 py-4 font-mono text-[0.8rem] leading-relaxed text-foreground"><code>{z.installCmd}
zsql init my-model &amp;&amp; cd my-model
zsql serve</code></pre>
        <p class="border-t border-border px-4 py-3 text-xs text-muted-foreground">
          Then POST a query spec and read the statement back.
        </p>
      </div>
    </div>
  </div>
</section>
