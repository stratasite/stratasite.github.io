---
/**
 * Property table for a schema: name, type, description, with nested objects
 * indented beneath their parent and named components linked to their own
 * section instead of repeated inline.
 */
import { propertyRows, renderDescription, schemaAnchor, type PropertyRow, type Schema } from '../../../data/openapi';

interface Props {
  schema: Schema;
  /** Expand named component types one level rather than linking them. */
  inlineRefs?: boolean;
}
const { schema, inlineRefs = false } = Astro.props;

const rows = propertyRows(schema, { inlineRefs });

function flat(list: PropertyRow[], depth = 0): (PropertyRow & { depth: number })[] {
  return list.flatMap((r) => [{ ...r, depth }, ...flat(r.children, depth + 1)]);
}
const all = flat(rows);
const fmt = (v: unknown) => (typeof v === 'string' ? v : JSON.stringify(v));
---

{
  all.length > 0 && (
    <div class="table-wrap api-props">
      <table>
        <thead>
          <tr>
            <th>Property</th>
            <th>Type</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {all.map((r) => (
            <tr>
              <td class="whitespace-nowrap font-mono text-[0.85em] text-foreground" style={`padding-left: calc(0.875rem + ${r.depth} * 1.1rem)`}>
                {r.depth > 0 && <span class="mr-1.5 text-muted-foreground/60" aria-hidden="true">↳</span>}
                {r.name}
                {r.required && <span class="ml-1.5 text-[0.7rem] font-sans font-semibold uppercase tracking-wider text-primary">required</span>}
              </td>
              <td class="whitespace-nowrap font-mono text-[0.8em] text-muted-foreground">
                {r.refName ? (
                  <a class="text-primary hover:underline" href={`#${schemaAnchor(r.refName)}`}>
                    {r.type}
                  </a>
                ) : (
                  r.type
                )}
              </td>
              <td>
                <Fragment set:html={renderDescription(r.description)} />
                {r.enum && (
                  <p class="api-enum">
                    One of{' '}
                    {r.enum.map((v, i) => (
                      <>
                        <code>{String(v)}</code>
                        {i < r.enum!.length - 1 ? ', ' : ''}
                      </>
                    ))}
                  </p>
                )}
                {r.default !== undefined && (
                  <p class="api-enum">
                    Default <code>{fmt(r.default)}</code>
                  </p>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
