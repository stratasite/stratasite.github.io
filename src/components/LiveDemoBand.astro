---
// Band advertising the hosted live demo (demo.strata.do). On the homepage it
// sits right under the hero so a visitor can get hands on before reading a
// word of positioning; on product pages it closes the argument, just before
// the closing CTA. The button goes straight to the demo site in a new tab.
import CtaButton from './CtaButton.astro';
import Icon from './Icon.astro';

interface Props {
  /** `cta_location` on the live_demo_click event, e.g. `home-band`, `bi-band`. */
  location: string;
  /** Page-specific second sentence: what to go try first. Defaults to a general one. */
  body?: string;
}
const {
  location,
  body = 'Ask a question in plain language, blend measures across facts, build a report.',
} = Astro.props;
---

<section class="border-t border-border bg-surface-2">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8 rounded-2xl border-2 border-primary bg-surface p-8 lg:flex-row lg:items-center lg:justify-between lg:p-10">
      <div class="flex items-start gap-5">
        <span class="hidden h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-primary/15 text-primary sm:flex">
          <Icon name="globe" class="h-7 w-7" />
        </span>
        <div>
          <p class="font-display text-sm font-semibold uppercase tracking-wider text-primary">Live demo</p>
          <h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
            Don't take our word for it. Click around.
          </h2>
          <p class="mt-3 max-w-2xl text-muted-foreground">
            A hosted Strata with a retail sample model already loaded. {body} Nothing to install.
          </p>
        </div>
      </div>
      <div class="shrink-0">
        <CtaButton action="live-demo" location={location} label="Open the live demo" class="w-full !py-3.5 text-base lg:w-auto" />
      </div>
    </div>
  </div>
</section>
