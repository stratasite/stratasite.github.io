---
// Reusable callout for article/feature MDX. Use inside MDX:
//   <Callout type="tip">Naming discipline matters…</Callout>
// Same markup and classes as the `:::tip` admonition syntax the docs use
// (src/plugins/remark-admonitions.mjs); both are styled by `.callout` in
// global.css.
interface Props {
  type?: 'note' | 'tip' | 'info' | 'warning' | 'caution' | 'danger';
  title?: string;
}
const { type = 'note', title } = Astro.props;

const defaultTitle = {
  note: 'Note',
  tip: 'Tip',
  info: 'Info',
  warning: 'Heads up',
  caution: 'Caution',
  danger: 'Danger',
} as const;
---

<aside class={`callout callout-${type} not-prose`}>
  <p class="callout-title">{title ?? defaultTitle[type]}</p>
  <div>
    <slot />
  </div>
</aside>
