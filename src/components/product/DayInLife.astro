---
// Narrative walkthrough: one concrete operator, one morning, start to finish.
// Alternating media rows with a timestamp per step, plus an "under the hood"
// line that hands the technical reader a link without interrupting the story.
import { Code } from 'astro:components';
import FeatureVisual from '../FeatureVisual.astro';

interface Step {
  time: string;
  title: string;
  body: string[];
  /** Optional pull quote or refusal example rendered as a device inside the step. */
  aside?: string;
  underHood?: { text: string; href?: string; label?: string };
  image?: string;
  video?: string;
  /** Named diagram from the FeatureVisual registry (e.g. 'blending'). */
  diagram?: string;
  /** Inline code sample, rendered in a dark ink panel. Proves "simple" better than a diagram. */
  code?: string;
  codeLang?: string;
  codeFile?: string;
  alt?: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<div class="mx-auto max-w-6xl space-y-20 lg:space-y-28">
  {steps.map((s, i) => {
    const flip = i % 2 === 1;
    return (
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16" data-reveal>
        <figure class={`dil-media relative ${flip ? 'lg:order-2' : ''}`}>
          {s.code ? (
            <div class="dil-code">
              {s.codeFile && (
                <div class="dil-code-head">
                  <span class="dil-code-dot" aria-hidden="true"></span>
                  {s.codeFile}
                </div>
              )}
              <Code code={s.code} lang={s.codeLang ?? 'yaml'} theme="github-dark" />
            </div>
          ) : s.diagram ? (
            <div class="dil-diagram">
              <FeatureVisual index={i} title={s.title} diagram={s.diagram} />
            </div>
          ) : s.video ? (
            <Fragment>
              <video data-video-zoom class="h-auto w-full rounded-xl border border-border" autoplay loop muted playsinline aria-label={s.alt}>
                <source src={s.video} type="video/mp4" />
              </video>
              <span class="video-zoom-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 3h6v6" /><path d="M9 21H3v-6" /><path d="M21 3l-7 7" /><path d="M3 21l7-7" />
                </svg>
                Expand
              </span>
            </Fragment>
          ) : s.image ? (
            <img src={s.image} alt={s.alt ?? ''} loading="lazy" class="h-auto w-full rounded-xl border border-border" />
          ) : null}
        </figure>

        <div class={flip ? 'lg:order-1' : ''}>
          <p class="font-display text-sm font-semibold uppercase tracking-wider text-primary tabular-nums">
            {s.time}
          </p>
          <h3 class="mt-3 font-display text-2xl font-bold tracking-tight sm:text-3xl">{s.title}</h3>
          {s.body.map((p) => (
            <p class="mt-4 text-[1.05rem] leading-relaxed text-muted-foreground" set:html={p} />
          ))}

          {s.aside && (
            <p class="mt-5 rounded-lg border-l-2 border-primary bg-surface px-4 py-3 text-[0.95rem] leading-relaxed text-foreground" set:html={s.aside} />
          )}

          {s.underHood && (
            <p class="mt-5 text-sm text-muted-foreground">
              <span class="font-semibold text-foreground">Under the hood:</span>{' '}
              <Fragment set:html={s.underHood.text} />
              {s.underHood.href && (
                <a href={s.underHood.href} class="ml-1 font-semibold text-primary hover:underline">
                  {s.underHood.label ?? 'Learn more'}
                </a>
              )}
            </p>
          )}
        </div>
      </div>
    );
  })}
</div>

<style>
  /* Only real media (screenshots, video) gets the lifted-card glow. Generated
     diagrams render borderless and blend into the page, like the homepage rows. */
  .dil-media :global(img),
  .dil-media :global(video) {
    box-shadow:
      0 20px 44px -20px rgba(0, 0, 0, 0.5),
      0 0 70px 4px color-mix(in srgb, var(--strata-peach) 20%, transparent);
  }

  /* Code panel: a dark ink surface that reads as a real artifact on the rust
     page. Ink is a brand color, so this is on-brand, not a white screenshot box. */
  .dil-code {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--strata-ink-line);
    box-shadow: 0 20px 44px -22px rgba(0, 0, 0, 0.55);
  }
  .dil-code-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.95rem;
    background: var(--strata-ink-soft);
    border-bottom: 1px solid var(--strata-ink-line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #a9b6ce;
  }
  .dil-code-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--strata-peach);
  }
  /* Force the Shiki background to deep ink for exact brand match, keep tokens. */
  .dil-code :global(pre.astro-code) {
    margin: 0;
    background: var(--strata-ink-deep) !important;
    padding: 1.15rem 1.3rem;
    overflow-x: auto;
    scrollbar-width: none; /* Firefox: scroll without a visible bar */
    font-size: 0.82rem;
    line-height: 1.6;
  }
  /* Chrome/Safari: hide the bar too. Content still scrolls if it overflows. */
  .dil-code :global(pre.astro-code::-webkit-scrollbar) {
    display: none;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  [data-reveal].in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Same reveal-on-scroll behavior as the homepage feature rows.
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    },
    { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>
