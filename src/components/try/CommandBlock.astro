---
// A terminal command with a copy button. Ink surface, peach text, same look as
// fenced code in articles. Every copy is tracked as `trial_command_copy` with
// the command id and the step it belongs to, so the funnel shows which
// commands people actually run.
interface Props {
  /** Stable id for analytics, e.g. `docker-run`. */
  id: string;
  /** The step number this command belongs to (analytics). */
  step?: string | number;
  /** The command text. Multi-line is fine. */
  code: string;
  class?: string;
}
const { id, step, code, class: className = '' } = Astro.props;
---

<div class={`cmd relative ${className}`}>
  <pre
    class="whitespace-pre-wrap [overflow-wrap:anywhere] rounded-xl border border-strata-cream/20 bg-code-surface py-4 pl-5 pr-24 font-mono text-[0.95rem] leading-relaxed text-strata-peach"
  ><code data-cmd-text>{code}</code></pre>
  <button
    type="button"
    class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-md border border-strata-cream/20 bg-strata-ink px-2.5 py-1 text-xs font-semibold text-strata-cream transition-colors hover:bg-strata-ink-soft focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
    data-copy
    data-track="trial_command_copy"
    data-track-command={id}
    data-track-step={step}
    aria-label="Copy command"
  >
    <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="7" y="7" width="9" height="9" rx="1.5" />
      <path d="M13 7V5.5A1.5 1.5 0 0 0 11.5 4h-6A1.5 1.5 0 0 0 4 5.5v6A1.5 1.5 0 0 0 5.5 13H7" />
    </svg>
    <span data-copy-label>Copy</span>
  </button>
</div>

<script>
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-copy]');
    if (!btn) return;
    const wrap = btn.closest('.cmd');
    const text = wrap?.querySelector<HTMLElement>('[data-cmd-text]')?.textContent ?? '';
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    try {
      await navigator.clipboard.writeText(text.trim());
      if (label) label.textContent = 'Copied';
    } catch {
      if (label) label.textContent = 'Select and copy';
    }
    setTimeout(() => {
      if (label) label.textContent = 'Copy';
    }, 1600);
  });
</script>
