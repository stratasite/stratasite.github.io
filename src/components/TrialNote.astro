---
// One line under a trial CTA that says what the trial actually is, so the
// click is a concrete thing rather than a vague "try it".
import { site } from '../config/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<p class={`text-sm text-muted-foreground ${className}`}>
  {site.trialDays} days of everything in Team, hosted for you, with a demo project ready to explore. Nothing to install.
</p>
