---
// One line under a trial CTA that says what the trial actually is: a hosted
// demo to click around in, or Docker on your own machine. Nobody clicks a
// vague "Try it free"; they click a concrete thing that is about to happen.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<p class={`text-sm text-muted-foreground ${className}`}>
  Play with the live demo in your browser, or run it on your own machine with Docker. Free, no credit card.
</p>
