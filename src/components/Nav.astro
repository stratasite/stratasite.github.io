---
import { getCollection } from 'astro:content';
import { nav, products, site } from '../config/site';
import CtaButton from './CtaButton.astro';
import Icon from './Icon.astro';

// The case studies rail in the Product dropdown is generated from the content
// collection so it never drifts from the published pages.
const caseStudies = (await getCollection('casestudies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<header class="sticky top-0 z-50 bg-strata-rust">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Left: logo + wordmark. Rust is a dark/busy field, so use the dark mark. -->
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <img src="/brand/assets/strata_mark_dark.svg" alt="" class="h-8 w-auto" />
      <span class="font-display text-2xl font-bold tracking-tight text-strata-cream">strata</span>
    </a>

    <!-- Center: primary navigation -->
    <ul class="hidden items-center gap-1 md:flex">
      <li class="group relative">
        <button
          class="flex items-center gap-1 rounded px-3 py-2 text-base font-semibold text-strata-cream hover:text-white"
          aria-haspopup="true"
        >
          Product
          <svg class="h-3.5 w-3.5 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <!-- Dropdown -->
        <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="flex w-[46rem] overflow-hidden rounded-lg border border-menu-border bg-menu shadow-2xl">
            <!-- Left: the three products -->
            <div class="flex-1 p-3">
              <p class="px-3 pb-1 pt-1 text-xs font-semibold uppercase tracking-wider text-menu-muted">
                Platform
              </p>
              {products.map((p) => (
                <a
                  href={`/product/${p.slug}/`}
                  class="group/item flex items-start gap-3 rounded-md p-3 transition-colors hover:bg-menu-raised"
                >
                  <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-menu-raised text-menu-primary transition-colors group-hover/item:bg-menu-primary group-hover/item:text-menu-primary-foreground">
                    <Icon name={p.icon} class="h-5 w-5" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold leading-snug text-menu-primary">{p.label}</span>
                    <span class="mt-0.5 block text-xs leading-snug text-menu-muted">{p.summary}</span>
                  </span>
                </a>
              ))}
            </div>

            <!-- Right: proof rail -->
            <div class="w-[17rem] shrink-0 border-l border-menu-border bg-menu-2 p-3">
              <p class="px-3 pb-1 pt-1 text-xs font-semibold uppercase tracking-wider text-menu-muted">
                Case studies
              </p>
              {caseStudies.map((cs) => (
                <a
                  href={`/case-studies/${cs.slug}/`}
                  class="block rounded-md p-3 transition-colors hover:bg-menu-raised"
                >
                  <span class="block text-sm font-semibold leading-snug text-menu-primary">
                    {cs.data.title}
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </li>
      {nav.links.map((link) => (
        <li>
          <a
            href={link.href}
            class="rounded px-3 py-2 text-base font-semibold text-strata-cream hover:text-white"
            {...('external' in link && link.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Right: CTA -->
    <div class="flex items-center gap-3">
      <CtaButton location="nav" class="hidden sm:inline-flex !px-4 !py-2 text-sm" />
    </div>
  </nav>
</header>
