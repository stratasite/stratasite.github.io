---
/**
 * The product doing the job, in five beats: one real clip each, one line each,
 * and a fifth beat that is an animated card for a feature that has not shipped
 * (data-driven automations, labelled "Coming soon"). Click a beat or let it
 * run; when a clip ends, or the card's run is over, the next beat starts.
 * Rendered as a rust band, so use it as the page's one rust surface.
 */
import AutomationCard from './AutomationCard.astro';

interface Props {
  heading?: string;
  /** The accented tail of the heading. */
  accent?: string;
  sub?: string;
  class?: string;
}
const {
  heading = 'From question to answer,',
  accent = 'without the ticket',
  sub = 'Here is what your operators do on day one.',
  class: className = '',
} = Astro.props;

const showcase = [
  {
    label: 'Ask',
    claim: 'Type the question in plain English. Strata resolves it to governed measures and the right filter.',
    video: '/ai_sprinkled_editor.mp4',
    alt: 'Resolving a natural language question into measures and a filter in the Strata editor',
  },
  {
    label: 'Build',
    claim: 'Pull measures from any domain. Only valid combinations are offered, and the preview updates as you go.',
    video: '/instant_feedback.mp4',
    alt: 'Building a cross domain view with instant validation and preview',
  },
  {
    label: 'Explore',
    claim: 'Dashboards that are beautiful by default and interactive out of the box. Drill, filter, compare.',
    video: '/interactive_dashboards.mp4',
    alt: 'Drilling and filtering an interactive Strata dashboard',
  },
  {
    label: 'Deliver',
    claim: 'Push it to Google Sheets, subscribe the team, or schedule it for Monday at seven.',
    video: '/exports_and_schedules.mp4',
    alt: 'Exporting a report to Google Sheets and scheduling it',
  },
  {
    label: 'Automate',
    claim: 'Watch a measure. When it crosses the line, Strata acts: a message, an email, a webhook.',
    // No clip: an animated card, run for a fixed time, and labelled as unshipped.
    panel: true,
    duration: 8000,
    soon: true,
    alt: 'A watched measure crosses its threshold and three actions fire',
  },
];
---

<section id="see-it" class={`band-rust scroll-mt-20 border-t border-border bg-background ${className}`}>
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {heading} <span class="text-primary">{accent}</span>
      </h2>
      <p class="mt-4 text-muted-foreground">{sub}</p>
    </div>

    <div class="mt-14 grid items-center gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-14" data-showcase>
      <!-- beats -->
      <ol class="space-y-3" role="tablist" aria-label="Product walkthrough">
        {showcase.map((b, i) => (
          <li>
            <button
              type="button"
              role="tab"
              id={`beat-${i}`}
              aria-controls={`clip-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-beat={i}
              class="beat w-full rounded-xl border border-border p-5 text-left transition-colors"
            >
              <span class="flex items-baseline gap-3">
                <span class="font-display text-sm font-bold tabular-nums text-primary">{String(i + 1).padStart(2, '0')}</span>
                <span class="font-display text-xl font-bold tracking-tight text-foreground">{b.label}</span>
                {'soon' in b && b.soon && (
                  <span class="beat-soon ml-auto rounded-full px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-primary">Coming soon</span>
                )}
              </span>
              <span class="mt-2 block text-sm leading-relaxed text-muted-foreground">{b.claim}</span>
              <span class="beat-bar mt-4 block h-0.5 w-full overflow-hidden rounded-full bg-border" aria-hidden="true">
                <span class="beat-fill block h-full w-0 bg-primary"></span>
              </span>
            </button>
          </li>
        ))}
      </ol>

      <!-- stage -->
      <div class="showcase-media">
        {showcase.map((b, i) =>
          'panel' in b && b.panel ? (
            <div
              id={`clip-${i}`}
              role="tabpanel"
              aria-labelledby={`beat-${i}`}
              data-clip={i}
              data-duration={b.duration}
              class="showcase-panel w-full rounded-xl"
              aria-label={b.alt}
              hidden={i !== 0}
            >
              <AutomationCard />
            </div>
          ) : (
            <video
              id={`clip-${i}`}
              role="tabpanel"
              aria-labelledby={`beat-${i}`}
              data-clip={i}
              class="w-full rounded-xl"
              src={b.video}
              muted
              playsinline
              preload={i === 0 ? 'auto' : 'metadata'}
              aria-label={b.alt}
              hidden={i !== 0}
            ></video>
          )
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .showcase-media video {
    display: block;
    box-shadow: var(--media-shadow);
  }
  .showcase-media video[hidden],
  .showcase-media .showcase-panel[hidden] {
    display: none;
  }
  .showcase-media .showcase-panel {
    display: block;
    box-shadow: var(--media-shadow);
  }
  .beat-soon {
    background: color-mix(in srgb, var(--primary) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 50%, transparent);
  }
  .beat {
    background: color-mix(in srgb, var(--surface) 60%, transparent);
  }
  .beat:hover {
    border-color: color-mix(in srgb, var(--primary) 60%, transparent);
  }
  .beat[aria-selected='true'] {
    border-color: var(--primary);
    background: var(--surface-2);
  }
  .beat-fill {
    transition: width 0.25s linear;
  }
</style>

<script>
  // One beat plays at a time; the active beat's bar tracks it, and the next
  // beat starts when it ends. A beat is a clip, or a timed panel whose CSS
  // animations (re)start when it is shown. Clicking a beat jumps to it.
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  if (root) {
    const beats = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-beat]'));
    const clips = Array.from(root.querySelectorAll<HTMLElement>('[data-clip]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let panelTimer = 0;
    let panelRaf = 0;

    function setFill(i: number, ratio: number) {
      const fill = beats[i].querySelector<HTMLElement>('.beat-fill');
      if (fill) fill.style.width = `${Math.min(1, Math.max(0, ratio)) * 100}%`;
    }

    function stopPanel() {
      window.clearTimeout(panelTimer);
      window.cancelAnimationFrame(panelRaf);
    }

    function runPanel(el: HTMLElement, i: number) {
      const card = el.firstElementChild as HTMLElement | null;
      const duration = Number(el.dataset.duration) || 8000;
      if (card) {
        // Restart the keyframes from the top.
        card.classList.remove('is-playing');
        void card.offsetWidth;
        card.classList.add('is-playing');
      }
      if (reduced) return;
      const started = performance.now();
      const tick = (now: number) => {
        if (i !== current) return;
        setFill(i, (now - started) / duration);
        panelRaf = window.requestAnimationFrame(tick);
      };
      panelRaf = window.requestAnimationFrame(tick);
      panelTimer = window.setTimeout(() => {
        if (i === current) show((current + 1) % clips.length);
      }, duration);
    }

    function show(i: number, focus = false) {
      current = i;
      stopPanel();
      beats.forEach((b, idx) => {
        const on = idx === i;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        if (!on) setFill(idx, 0);
        if (on && focus) b.focus();
      });
      clips.forEach((el, idx) => {
        const on = idx === i;
        el.hidden = !on;
        if (el instanceof HTMLVideoElement) {
          if (on) {
            el.currentTime = 0;
            if (!reduced) el.play().catch(() => {});
          } else {
            el.pause();
          }
        } else if (on) {
          runPanel(el, idx);
        }
      });
    }

    clips.forEach((el, i) => {
      if (!(el instanceof HTMLVideoElement)) return;
      el.addEventListener('timeupdate', () => {
        if (i !== current || !Number.isFinite(el.duration) || el.duration === 0) return;
        setFill(i, el.currentTime / el.duration);
      });
      el.addEventListener('ended', () => {
        if (i === current) show((current + 1) % clips.length);
      });
    });

    beats.forEach((b, i) => {
      b.addEventListener('click', () => show(i));
      b.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const dir = e.key === 'ArrowDown' ? 1 : -1;
        show((i + dir + beats.length) % beats.length, true);
      });
    });

    // Only start once the band is on screen, so it is not competing with a
    // hero clip at load.
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        show(0);
        io.disconnect();
      }
    }, { threshold: 0.3 });
    io.observe(root);
  }
</script>
