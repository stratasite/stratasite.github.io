---
/**
 * The home hero's picture: the product's loop, read top to bottom, on a
 * quiet field as floating cards.
 *
 *   1. the access modes, centred and evenly weighted, so the strip reads
 *      "however you come in";
 *   2. a question in English, in the input it was sent from;
 *   3. hanging off it as a process tree: the plan (measures resolved, grain
 *      checked), the chart that came back with one week out of line, the
 *      follow-up question about that week, its plan, and the answer as two
 *      lines of analysis.
 *
 * The tree is the direction: a trunk drops from the input and an elbow turns
 * into each card, so the eye reads "the question caused these". Everything is
 * drawn from semantic tokens, so it holds on ink, on a light surface, and
 * inside a rust band. It animates once on first load (each step settles in,
 * the questions type themselves, the lines draw, the spike lands) and is
 * static under prefers-reduced-motion.
 *
 * Kept short on purpose: it has to sit above the fold beside the headline.
 * The numbers are illustrative, in the shape of the customer service demo.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const modes = [
  { label: 'User', icon: 'user' },
  { label: 'Agent', icon: 'agent' },
  { label: 'MCP', icon: 'mcp' },
  { label: 'API', icon: 'api' },
  { label: 'Sheets', icon: 'sheets' },
] as const;

const q1 = 'weekly contacts vs last year';
const plan1 = { args: 'Contacts, Contacts YoY · by Week · last 8 weeks', result: '2 measures · grain safe' };
const weeks = ['W1', 'W2', 'W3', 'W4', 'W5', 'W6', 'W7', 'W8'];
const thisYear = [410, 395, 430, 405, 420, 690, 440, 415];
const lastYear = [380, 390, 400, 410, 395, 405, 420, 410];
const spike = 5; // index of the week out of line
const spikeLabel = '+70% YoY';
const q2 = 'what happened in week 6';
const plan2 = { args: 'Contacts · by Contact Reason · Week 6 vs prior 4 weeks', result: 'segment vs baseline · 90 ms' };
const analysis = {
  lead: 'Account Login ran 2.3× its four-week baseline, 1,840 contacts above expected.',
  rest: 'Every other reason stayed in range.',
};

// Chart geometry (viewBox units): a wide, short panel so the card stays low.
const W = 320;
const H = 60;
const padX = 14;
const base = 50;
const top = 8;
const lo = 300;
const hi = 720;
const x = (i: number) => padX + (i * (W - padX * 2)) / (weeks.length - 1);
const y = (v: number) => base - ((v - lo) / (hi - lo)) * (base - top);
const path = (vals: number[]) => vals.map((v, i) => `${i === 0 ? 'M' : 'L'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');

// Timeline, in ms from load. Each card has its own delay so typing, the
// line draw and the spike marker can be sequenced between the entrances.
const t = { tray: 100, q1: 450, type1: 600, plan1: 1800, chart: 2200, draw: 2450, spike: 3250, q2: 3600, type2: 3750, plan2: 4800, analysis: 5200 };

const card = 'story-card flex items-start gap-3 rounded-xl bg-surface px-4 py-2 font-mono text-xs sm:text-[0.8rem]';
const input = 'story-input flex items-center gap-3 rounded-xl bg-surface px-4 py-2.5 font-mono text-[0.95rem] text-foreground';
---

<figure
  class={`hero-story relative overflow-hidden rounded-2xl border border-border p-4 sm:p-5 ${className}`}
  aria-label="A question in English becomes a planned query and a chart with one week out of line; a follow-up question about that week becomes a planned query and a two-line analysis"
>
  <!-- 1. Access modes. Strata does not care which. -->
  <div class="story-step" style={`--d: ${t.tray}ms`}>
    <div class="story-tray mx-auto flex w-fit max-w-full flex-wrap items-center justify-center gap-x-5 gap-y-1 rounded-xl px-4 py-2 sm:gap-x-6">
      <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-muted-foreground">any access mode</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 sm:gap-x-5" role="list">
        {modes.map((m) => (
          <li class="flex items-center gap-1.5 text-muted-foreground">
            <svg viewBox="0 0 24 24" class="h-[16px] w-[16px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {m.icon === 'user' && <><circle cx="12" cy="8" r="4" /><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0" /></>}
              {m.icon === 'agent' && <><path d="M12 3.5l1.9 5.6 5.6 1.9-5.6 1.9L12 18.5l-1.9-5.6L4.5 11l5.6-1.9Z" /><path d="M19 17.5v3M17.5 19h3" stroke-opacity=".6" /></>}
              {m.icon === 'mcp' && <><path d="M9 3v5M15 3v5" /><path d="M6 8h12v2.5a6 6 0 0 1-12 0Z" /><path d="M12 16.5V21" /></>}
              {m.icon === 'api' && <><path d="M8.5 4C6.5 4 6 5 6 7v2.5c0 1.2-.8 2-2 2.5 1.2.5 2 1.3 2 2.5V17c0 2 .5 3 2.5 3" /><path d="M15.5 4c2 0 2.5 1 2.5 3v2.5c0 1.2.8 2 2 2.5-1.2.5-2 1.3-2 2.5V17c0 2-.5 3-2.5 3" /></>}
              {m.icon === 'sheets' && <><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M4 10h16M4 15h16M10 4v16" stroke-opacity=".7" /></>}
            </svg>
            <span class="font-mono text-[0.72rem] tracking-wide">{m.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- 2. The first question, typed into the input. -->
  <div class={`story-step mt-3 ${input}`} style={`--d: ${t.q1}ms`}>
    <span class="story-typed min-w-0 flex-1" style={`--chars: ${q1.length}; --d: ${t.type1}ms`}>{q1}</span>
    <kbd class="story-key shrink-0 rounded-md border border-border px-1.5 py-0.5 font-mono text-[0.7rem] leading-none text-muted-foreground" aria-hidden="true">&crarr;</kbd>
  </div>

  <!-- 3. What the question set off, hanging off it as a tree. -->
  <div class="story-tree mt-2.5 pl-7">
    <ol class="space-y-2.5" role="list">
      <!-- plan -->
      <li class={`story-step story-branch ${card}`} style={`--d: ${t.plan1}ms`}>
        <img src="/brand/assets/strata_mark_dark.svg" alt="" class="mt-px h-[18px] w-auto shrink-0" />
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-3">
            <code class="text-foreground">plan query</code>
            <span class="ml-auto flex shrink-0 items-center gap-1.5 tabular-nums text-muted-foreground">
              <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
              {plan1.result}
            </span>
          </div>
          <code class="mt-0.5 block truncate text-[0.7rem] text-muted-foreground sm:text-xs">{plan1.args}</code>
        </div>
      </li>

      <!-- chart: this year against last, one week out of line -->
      <li class={`story-step story-branch ${card}`} style={`--d: ${t.chart}ms`}>
        <img src="/brand/assets/strata_mark_dark.svg" alt="" class="mt-px h-[18px] w-auto shrink-0" />
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-3">
            <code class="text-foreground">chart</code>
            <span class="ml-auto flex shrink-0 items-center gap-3 text-[0.7rem] text-muted-foreground">
              <span class="flex items-center gap-1"><span class="inline-block h-0.5 w-3 rounded-full" style="background: var(--chart-3)"></span>This year</span>
              <span class="flex items-center gap-1"><span class="story-ly-swatch inline-block h-0.5 w-3 rounded-full"></span>Last year</span>
            </span>
          </div>
          <svg viewBox={`0 0 ${W} ${H}`} class="story-chart mt-1.5 block w-full" role="img" aria-label="Weekly contacts this year against last year over eight weeks; week six is 70 percent above last year">
            <line x1="0" y1={base} x2={W} y2={base} class="story-axis" stroke-width="1" />
            <path d={path(lastYear)} class="story-line story-line-ly" pathLength="1" style={`--d: ${t.draw}ms`} />
            <path d={path(thisYear)} class="story-line story-line-ty" pathLength="1" style={`--d: ${t.draw + 150}ms`} />
            <g class="story-spike" style={`--d: ${t.spike}ms; transform-origin: ${x(spike).toFixed(1)}px ${y(thisYear[spike]).toFixed(1)}px`}>
              <circle cx={x(spike)} cy={y(thisYear[spike])} r="3.5" class="story-spike-dot" />
              <text x={x(spike) - 6} y={y(thisYear[spike]) + 3.5} text-anchor="end" class="story-spike-label" font-size="9">{spikeLabel}</text>
            </g>
            {weeks.map((w, i) => (
              <text x={x(i)} y={H - 2} text-anchor="middle" class="story-label" font-size="8.5">{w}</text>
            ))}
          </svg>
        </div>
      </li>

      <!-- drill-down question -->
      <li class={`story-step story-branch ${input}`} style={`--d: ${t.q2}ms`}>
        <span class="story-typed min-w-0 flex-1" style={`--chars: ${q2.length}; --d: ${t.type2}ms`}>{q2}</span>
        <kbd class="story-key shrink-0 rounded-md border border-border px-1.5 py-0.5 font-mono text-[0.7rem] leading-none text-muted-foreground" aria-hidden="true">&crarr;</kbd>
      </li>

      <!-- plan -->
      <li class={`story-step story-branch ${card}`} style={`--d: ${t.plan2}ms`}>
        <img src="/brand/assets/strata_mark_dark.svg" alt="" class="mt-px h-[18px] w-auto shrink-0" />
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-3">
            <code class="text-foreground">plan query</code>
            <span class="ml-auto flex shrink-0 items-center gap-1.5 tabular-nums text-muted-foreground">
              <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
              {plan2.result}
            </span>
          </div>
          <code class="mt-0.5 block truncate text-[0.7rem] text-muted-foreground sm:text-xs">{plan2.args}</code>
        </div>
      </li>

      <!-- analysis: the answer, in two lines -->
      <li class={`story-step story-branch story-end ${card}`} style={`--d: ${t.analysis}ms`}>
        <img src="/brand/assets/strata_mark_dark.svg" alt="" class="mt-px h-[18px] w-auto shrink-0" />
        <div class="min-w-0 flex-1">
          <code class="text-foreground">analysis</code>
          <p class="mt-0.5 text-[0.7rem] leading-relaxed text-muted-foreground sm:text-xs">
            <span class="text-foreground">{analysis.lead}</span> {analysis.rest}
          </p>
        </div>
      </li>
    </ol>
  </div>

  <figcaption class="sr-only">
    A person, an agent, an MCP client, an API call, or the Google Sheets add-on asks "{q1}". Strata plans the query
    against the governed model and returns a chart of eight weeks, this year against last, with week six {spikeLabel}.
    The follow-up "{q2}" is planned as a segment against its four-week baseline and answered in two lines:
    {analysis.lead} {analysis.rest}
  </figcaption>
</figure>

<style>
  /* The stage: a quiet field, a touch darker at the top, so the cards read
     as objects on it. Every colour is a semantic token, so the same markup
     holds on ink, on cream, and inside a rust band. */
  .hero-story {
    --rail: var(--primary);
    --shade: color-mix(in srgb, var(--foreground) 12%, transparent);
    --shade-strong: color-mix(in srgb, var(--foreground) 35%, transparent);
    background: linear-gradient(180deg, var(--surface-2), color-mix(in srgb, var(--surface-2) 55%, var(--background)));
  }
  .story-card,
  .story-input {
    border: 1px solid var(--border);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--background) 40%, transparent),
      0 10px 24px -14px color-mix(in srgb, var(--background) 80%, transparent);
  }
  /* The inputs are focused: the question was just sent from them. */
  .story-input {
    border-color: color-mix(in srgb, var(--primary) 55%, var(--border));
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--primary) 16%, transparent),
      0 10px 24px -14px color-mix(in srgb, var(--background) 80%, transparent);
  }
  .story-tray {
    background: color-mix(in srgb, var(--surface-2) 60%, var(--surface));
    border: 1px solid var(--border);
  }
  .story-key {
    background: var(--surface-2);
  }

  /* The tree. A trunk drops from under the input, and each card gets an
     elbow off it. Cards that are not last carry the trunk on to the next. */
  .story-branch {
    position: relative;
  }
  .story-branch::before {
    content: '';
    position: absolute;
    left: -1.3rem;
    top: -0.65rem;
    width: 1.3rem;
    height: calc(0.65rem + 1.1rem);
    border-left: 2px solid var(--rail);
    border-bottom: 2px solid var(--rail);
    border-bottom-left-radius: 0.65rem;
    pointer-events: none;
  }
  .story-branch:not(.story-end)::after {
    content: '';
    position: absolute;
    left: -1.3rem;
    top: 1.1rem;
    bottom: -0.75rem;
    border-left: 2px solid var(--rail);
    pointer-events: none;
  }

  /* Chart chrome, on the neutral ramp; this year's line in the accent. */
  .story-axis {
    stroke: var(--shade);
  }
  .story-label {
    fill: var(--muted-foreground);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .story-line {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .story-line-ly,
  .story-ly-swatch {
    stroke: var(--shade-strong);
    background: var(--shade-strong);
  }
  .story-line-ly {
    stroke-dasharray: 1;
  }
  .story-line-ty {
    stroke: var(--chart-3);
  }
  .story-spike-dot {
    fill: var(--chart-3);
    stroke: var(--surface);
    stroke-width: 1.5;
  }
  .story-spike-label {
    fill: var(--foreground);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 600;
  }

  /* First load: each step settles in on its own delay; the questions type
     themselves; the lines draw; the spike lands. Runs once. */
  @keyframes story-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes story-type {
    from { width: 0; }
    to { width: calc(var(--chars) * 1ch); }
  }
  @keyframes story-caret {
    0%, 100% { border-color: transparent; }
    50% { border-color: var(--primary); }
  }
  @keyframes story-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes story-pop {
    from { opacity: 0; transform: scale(0.4); }
    to { opacity: 1; transform: scale(1); }
  }
  .story-step {
    animation: story-in 0.5s ease-out both;
    animation-delay: var(--d);
  }
  .story-typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    max-width: 100%;
    border-right: 2px solid transparent;
    animation:
      story-type calc(var(--chars) * 32ms) steps(var(--chars)) both,
      story-caret 0.7s step-end 4;
    animation-delay: var(--d), var(--d);
  }
  .story-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: story-draw 0.7s ease-out both;
    animation-delay: var(--d);
  }
  .story-spike {
    animation: story-pop 0.35s cubic-bezier(0.2, 0.7, 0.2, 1.3) both;
    animation-delay: var(--d);
  }
  @media (prefers-reduced-motion: reduce) {
    .story-step,
    .story-typed,
    .story-line,
    .story-spike {
      animation: none;
    }
    .story-typed {
      width: auto;
      white-space: normal;
    }
    .story-line {
      stroke-dashoffset: 0;
    }
  }
</style>
