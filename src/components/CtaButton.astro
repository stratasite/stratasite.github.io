---
import { site } from '../config/site';

interface Props {
  /**
   * What the button does. `trial` (default) sends the visitor to the free trial
   * page; `demo` opens the scheduler. Site-wide, trial is the primary action
   * and demo the secondary one.
   */
  action?: 'trial' | 'demo';
  /**
   * Visual style. `primary` = filled peach; `ghost` = outlined/subtle. Defaults
   * to primary for trial and ghost for demo, so a trial + demo pair reads as
   * primary + secondary without extra props.
   */
  variant?: 'primary' | 'ghost';
  label?: string;
  class?: string;
  /**
   * In-page placement (e.g. `hero`, `pricing-team`, `footer`), sent as
   * `cta_location` on the GA4 event (`trial_cta_click` or `generate_lead`) so
   * clicks can be attributed to where the visitor was. Omit and the event still fires.
   */
  location?: string;
}

const { action = 'trial', class: className = '', location } = Astro.props;
const variant = Astro.props.variant ?? (action === 'trial' ? 'primary' : 'ghost');
const label = Astro.props.label ?? (action === 'trial' ? site.trialLabel : site.demoLabel);
const href = action === 'trial' ? site.trialUrl : site.demoUrl;
const event = action === 'trial' ? 'trial_cta_click' : 'generate_lead';

const base =
  'cta inline-flex items-center justify-center rounded-sm no-underline shadow-sm font-display font-bold uppercase tracking-wide px-6 py-3 transition-[box-shadow,transform,filter] duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:brightness-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';

const variants = {
  // Peach (primary) background with deep-rust text, site-wide. Hover flair comes
  // from the base (lift + shadow + slight brightness), so the text stays crisp.
  primary: 'bg-primary text-primary-foreground',
  // Peach outline so the secondary action reads as a button next to the filled primary.
  ghost: 'border border-primary bg-transparent text-foreground hover:bg-primary/10',
};
---

<a
  href={href}
  {...(action === 'demo' ? { target: '_blank', rel: 'noopener' } : {})}
  data-cta={action}
  data-track={event}
  data-track-cta-location={location}
  class={`${base} ${variants[variant]} ${className}`}
>
  {label}
</a>
