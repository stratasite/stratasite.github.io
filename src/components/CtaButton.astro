---
import { site } from '../config/site';

interface Props {
  /**
   * What the button does. `trial` (default) sends the visitor to the free trial
   * page; `demo` opens the book-a-call scheduler; `live-demo` opens the hosted
   * demo site in a new tab. Site-wide, trial is the primary action and demo
   * the secondary one.
   */
  action?: 'trial' | 'demo' | 'live-demo';
  /**
   * Visual style. `primary` = filled; `ghost` = outlined/subtle. Defaults
   * to primary for trial and live-demo and ghost for demo, so a trial + demo
   * pair reads as primary + secondary without extra props.
   */
  variant?: 'primary' | 'ghost';
  label?: string;
  class?: string;
  /**
   * In-page placement (e.g. `hero`, `pricing-team`, `footer`), sent as
   * `cta_location` on the GA4 event (`trial_cta_click`, `generate_lead` or
   * `live_demo_click`) so clicks can be attributed to where the visitor was.
   * Omit and the event still fires.
   */
  location?: string;
}

const { action = 'trial', class: className = '', location } = Astro.props;
const targets = {
  trial: { label: site.trialLabel, href: site.trialUrl, event: 'trial_cta_click', variant: 'primary', external: false },
  demo: { label: site.demoLabel, href: site.demoUrl, event: 'generate_lead', variant: 'ghost', external: true },
  'live-demo': { label: site.liveDemoLabel, href: site.liveDemoUrl, event: 'live_demo_click', variant: 'primary', external: true },
} as const;
const target = targets[action];
const variant = Astro.props.variant ?? target.variant;
const label = Astro.props.label ?? target.label;
const { href, event } = target;

const base =
  'cta inline-flex items-center justify-center rounded-sm no-underline shadow-sm font-display font-bold uppercase tracking-wide px-6 py-3 transition-[box-shadow,transform,filter] duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:brightness-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';

const variants = {
  // Peach (primary) background with deep-rust text, site-wide. Hover flair comes
  // from the base (lift + shadow + slight brightness), so the text stays crisp.
  primary: 'bg-cta text-cta-foreground',
  // Peach outline so the secondary action reads as a button next to the filled primary.
  ghost: 'border border-primary bg-transparent text-foreground hover:bg-primary/10',
};
---

<a
  href={href}
  {...(target.external ? { target: '_blank', rel: 'noopener' } : {})}
  data-cta={action}
  data-track={event}
  data-track-cta-location={location}
  class={`${base} ${variants[variant]} ${className}`}
>
  {label}
</a>
