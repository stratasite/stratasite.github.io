---
/**
 * Home page, aimed at the mid-market buyer: most have Power BI, Tableau or
 * Looker, some have nothing but spreadsheets yet. The operator and correctness
 * lead, the pain is named in the buyer's words, price and warehouse coverage
 * are on the page, and the architecture pitch (OLAP, YAML, agents as
 * infrastructure) moves to the back. The technical and enterprise buyer gets
 * the platform story at /enterprise/.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FeatureRows from '../components/FeatureRows.astro';
import CtaButton from '../components/CtaButton.astro';
import TrialNote from '../components/TrialNote.astro';
import ShowcaseBand from '../components/ShowcaseBand.astro';
import HeroStory from '../components/HeroStory.astro';
import PainScene from '../components/PainScene.astro';
import DifferenceScene from '../components/DifferenceScene.astro';
import { site } from '../config/site';
import { editions } from '../data/pricing';

const title = 'Strata: self-service analytics your business users can actually use';
const description =
  'Business intelligence for the people who run the business. No formula language, no ticket queue, no two dashboards that disagree. Hosted on your warehouse, from $99 a month.';

const [entry] = editions;
const perUser = entry.users.price; // what one more user costs on Entry

const caseStudies = (await getCollection('casestudies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const study = caseStudies[0];
const studyHref = study ? `/case-studies/${study.slug}/` : '/case-studies/';

// Feature rows, reordered for this buyer and re-blurbed in their words. The
// entries are the shared `features` collection; only the blurb is overridden,
// so the detail pages and visuals are the same ones the current home uses.
const blurbs: Record<string, string> = {
  'beautiful-self-service':
    'Drop views in the order you want them read and the layout engine sizes, places and colors them. No pixel pushing, and nobody waiting on the one person who makes dashboards look right.',
  'instant-feedback':
    'No dataset, explore or cube to pick first. The whole model is open, every step is validated as you build, and an invalid query is refused before it runs.',
  'grain-safe-blending':
    'Revenue from billing beside tickets from the CRM, by week, in one view. Strata aggregates each to the right grain and cannot double count.',
  'measure-types':
    'Running balances, share of total, year over year, a cohort beside the baseline. Fields and one-click transforms, not a formula language to learn.',
  'ai-native':
    'Type the question in English and it resolves to governed fields. Build an agent the way you build a report. There is no path to a wrong number.',
  'semantic-layer-as-code':
    'Your engineer, or their coding agent, models the warehouse once in plain YAML. strata audit checks it against the warehouse before it ships. Everything above runs on it.',
  'federated-olap':
    'Dashboards and agents answer in under a second from aggregate tables and hot tiers, and the warehouse does less work, not more.',
};
const order = Object.keys(blurbs);
const all = await getCollection('features', ({ data }) => !data.draft);
const features = order
  .map((slug) => all.find((f) => f.slug === slug))
  .filter((f): f is NonNullable<typeof f> => Boolean(f))
  .map((f) => ({ ...f, data: { ...f.data, blurb: blurbs[f.slug] } }));

// The three states of the scene below, numbered to match its zone labels.
const steps = [
  { lead: 'Business users line up with questions.', rest: 'Revenue by region, tickets per customer, churn against last year.' },
  { lead: 'The BI tool and its bolt-on chat answer with a roadblock.', rest: 'The formula is wrong, the blend does not exist, the source was never connected.' },
  { lead: 'Every question becomes a ticket.', rest: 'The data team is already behind, and the backlog only grows.' },
];

// The same three columns, with Strata in the middle: the after to the above.
const diffSteps = [
  { lead: 'The same people ask the same questions.', rest: 'Broad ones, across domains, in plain English. No formula, no table to pick, no ticket.' },
  { lead: 'A semantic layer built for the people asking.', rest: 'It knows the measures, the grain and the joins, lights up what a question touches, routes to the fastest engine, and answers in milliseconds. A wrong number is not possible.' },
  { lead: 'The data team models once.', rest: 'YAML in Git, deployed to the hosted app. Every question after that answers itself, so the backlog is answers, not tickets.' },
];

const engines = [
  'SQL Server and Azure SQL',
  'Snowflake',
  'Databricks',
  'Redshift',
  'Athena',
  'Postgres',
  'MySQL',
  'ClickHouse',
  'Druid',
  'Trino',
  'DuckDB',
];
---

<Base title={title} description={description}>
  <!-- HERO: the operator and correctness, not the AI age -->
  <section class="border-b border-border">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="font-display text-sm font-semibold uppercase tracking-wider text-primary">Power analytics for non-technical users</p>
          <h1 class="mt-4 font-display text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl">
            Self-service analytics your business users can actually use. <span class="text-primary">Only correct answers.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
            Business intelligence for the people who run the business. No formula language, no ticket queue, no
            two dashboards that disagree. On your warehouse, hosted for you.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <CtaButton location="home-hero" />
            <CtaButton action="pricing" location="home-hero" />
          </div>
          <TrialNote class="mt-4" />
        </div>
        <div class="v2-media">
          <!-- The loop, as one picture. The 2 minute demo opens from the button below. -->
          <HeroStory />
          <button type="button" class="hero-play-pill mx-auto mt-4 flex items-center gap-2 rounded-full px-4 py-2 font-display text-sm font-semibold uppercase tracking-wider transition-colors" data-hero-open data-track="video_open" data-track-cta-location="home-hero-button">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.3 3.6A1 1 0 0 0 4.8 4.5v11a1 1 0 0 0 1.5.9l9.5-5.5a1 1 0 0 0 0-1.8z" /></svg>
            Watch the 2 minute demo
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICE: the number, and the reason it is possible -->
  <section class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center md:flex-row md:gap-10 md:text-left">
        <div class="shrink-0 rounded-xl bg-primary/10 px-8 py-5 text-center">
          <p class="font-display text-5xl font-bold tabular-nums text-primary sm:text-6xl">${perUser}</p>
          <p class="mt-1 text-sm font-semibold text-foreground">per user, per month</p>
          <p class="mt-1 text-xs text-muted-foreground">Entry starts at ${entry.price} a month for {entry.users.included} users.</p>
        </div>
        <div>
          <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
            Advanced analytics at a price <span class="text-primary">AI made possible.</span>
          </h2>
          <p class="mt-3 text-muted-foreground">
            A platform this capable used to take a large engineering team, years of work, and a price to
            match. AI let us build Strata's advanced analytics for a fraction of that cost. The savings go
            to you.
          </p>
        </div>
      </div>
      <p class="mt-8 text-center text-xs uppercase tracking-[0.2em] text-muted-foreground">
        Architecture born at Netflix. <a href={studyHref} class="text-primary hover:underline">Read the story</a>
      </p>
    </div>
  </section>

  <!-- THE PAIN, IN THEIR WORDS -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Sound familiar?</h2>
      </div>
      <!-- Three columns, centred, on the same grid as the scene's three zones below. -->
      <ol class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-3">
        {steps.map((st, i) => (
          <li class="flex flex-col items-center px-2 text-center">
            <span class="font-display text-2xl font-bold leading-none text-primary">{i + 1}</span>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground"><span class="font-semibold text-foreground">{st.lead}</span> {st.rest}</p>
          </li>
        ))}
      </ol>
      <PainScene class="mx-auto mt-6 max-w-5xl" />
    </div>
  </section>

  <!-- HOW STRATA IS DIFFERENT: the same stage, with Strata in the middle -->
  <section id="different" class="scroll-mt-20 border-t border-border bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-display text-sm font-semibold uppercase tracking-wider text-primary">How Strata is different</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
          Power use, for people who are not power users.
        </h2>
        <p class="mt-4 text-muted-foreground">
          A semantic layer built for the people asking, not for the people modeling. Model the business once;
          every question after that comes back in milliseconds, for anyone, with no path to a wrong number.
        </p>
      </div>
      <ol class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-3">
        {diffSteps.map((st, i) => (
          <li class="flex flex-col items-center px-2 text-center">
            <span class="font-display text-2xl font-bold leading-none text-primary">{i + 1}</span>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground"><span class="font-semibold text-foreground">{st.lead}</span> {st.rest}</p>
          </li>
        ))}
      </ol>
      <DifferenceScene class="mx-auto mt-6 max-w-5xl" />
    </div>
  </section>

  <!-- SHOWCASE (the page's one rust band) -->
  <ShowcaseBand />

  <!-- FEATURES, reordered for this buyer -->
  <section id="features" class="scroll-mt-20 border-t border-border">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
          Built for the <span class="text-primary">operator</span>, safe for <span class="text-primary">AI</span>
        </h2>
        <p class="mt-4 text-muted-foreground">
          What the people who run the business get, and the model underneath that makes it correct.
        </p>
      </div>
      <div class="mt-16">
        <FeatureRows features={features} />
      </div>
    </div>
  </section>

  <!-- CONNECTS TO: one line, because this is where a SQL Server shop bounces -->
  <section class="border-t border-border bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-12 text-center sm:px-6 lg:px-8">
      <p class="font-display text-sm font-semibold uppercase tracking-wider text-primary">Connects to</p>
      <ul class="mx-auto mt-4 flex max-w-4xl flex-wrap justify-center gap-x-2 gap-y-2">
        {engines.map((e) => (
          <li class="rounded-full border border-border bg-surface-2 px-3 py-1 text-sm text-foreground">{e}</li>
        ))}
      </ul>
      <p class="mt-4 text-sm text-muted-foreground">
        Your data stays in your warehouse. <a href="/docs/semantic-model/adapters/" class="font-semibold text-primary hover:underline">All adapters</a>
      </p>
    </div>
  </section>

  <!-- CUSTOMER STORY, framed for a smaller company -->
  {study && (
    <section class="border-t border-border">
      <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <div>
            <p class="font-display text-sm font-semibold uppercase tracking-wider text-primary">Customer story</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
              <a href={studyHref} class="transition-colors hover:text-primary">The request queue problem, solved once</a>
            </h2>
            <p class="mt-5 text-lg text-muted-foreground">
              A customer service org had a great BI tool and a Slack channel drowning in data requests. They gave 800
              non-technical people governed self-service instead. Weekly self-serve users went from five to hundreds
              and ad hoc requests fell 90%. Your team is smaller. The queue is the same.
            </p>
            <figure class="mt-8 border-l-2 border-primary pl-4">
              <blockquote class="text-foreground">"You took the complexity of Tableau and smashed it down to nothing."</blockquote>
              <figcaption class="mt-1.5 text-sm text-muted-foreground">Customer Service Product Manager</figcaption>
            </figure>
            <a href={studyHref} class="mt-8 inline-flex items-center gap-1 font-semibold text-primary transition-all hover:gap-2">
              Read the case study
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.17 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
            </a>
          </div>
          <figure class="v2-media">
            <img
              src="/cs_case_study.jpg"
              alt="Customer service team wearing headsets at their desks in a call center"
              width="1024"
              height="683"
              loading="lazy"
              class="h-auto w-full rounded-2xl border border-border"
            />
          </figure>
        </div>
      </div>
    </section>
  )}

  <!-- CLOSING CTA -->
  <section class="border-t border-border bg-surface-2">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Put Strata in front of your operators this week</h2>
      <p class="mt-4 text-muted-foreground">
        {site.trialDays} days of the hosted app with a demo project ready to explore. Connect your warehouse when you
        are ready. Keep the BI tool you have for what it does well, or make this your first.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <CtaButton location="home-closing" />
        <CtaButton action="pricing" location="home-closing" />
      </div>
      <p class="mt-8 text-sm text-muted-foreground">
        Evaluating the platform for a data team? <a href="/enterprise/" class="font-semibold text-primary hover:underline">Strata for enterprise</a>: semantic layer, federated OLAP, agents.
      </p>
    </div>
  </section>

  <!-- FULL WALKTHROUGH: opened from the hero loop -->
  <dialog class="hero-lightbox" data-hero-dialog aria-label="Strata demo">
    <div class="hero-lightbox-frame">
      <button type="button" class="hero-lightbox-close" data-hero-close aria-label="Close">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <video
        class="hero-lightbox-video"
        data-hero-full
        src="/hero_v3.mp4"
        controls
        muted
        playsinline
        preload="none"
        aria-label="Demo: asking the Strata agent for a dashboard, subscribing the team with a PDF, and exporting to Google Sheets"
      ></video>
    </div>
  </dialog>
</Base>

<style>
  .v2-media video,
  .v2-media img {
    display: block;
    box-shadow: var(--media-shadow);
  }
  .hero-play-pill {
    color: var(--foreground);
    border: 1px solid color-mix(in srgb, var(--foreground) 25%, transparent);
  }
  .hero-play-pill:hover,
  .hero-play-pill:focus-visible {
    background: var(--cta);
    color: var(--cta-foreground);
    border-color: transparent;
  }

  .hero-lightbox {
    width: min(96vw, calc((100vh - 6rem) * 16 / 9));
    max-width: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .hero-lightbox::backdrop {
    background: color-mix(in srgb, var(--background) 88%, transparent);
    backdrop-filter: blur(4px);
  }
  .hero-lightbox-frame {
    position: relative;
  }
  .hero-lightbox-video {
    display: block;
    width: 100%;
    border-radius: 0.75rem;
    background: var(--background);
    box-shadow: var(--media-shadow);
  }
  .hero-lightbox-close {
    position: absolute;
    top: -2.75rem;
    right: 0;
    display: inline-flex;
    padding: 0.5rem;
    border-radius: 9999px;
    color: var(--foreground);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }
  .hero-lightbox-close:hover,
  .hero-lightbox-close:focus-visible {
    background: var(--cta);
    color: var(--cta-foreground);
    outline: none;
  }
</style>

<script>
  import { track } from '../scripts/track';

  // Hero lightbox: the 2 minute demo video, opened from the button under
  // the hero graphic, with controls.
  // Opens are tracked by the delegated [data-track] listener; watch depth is
  // sent from here as video_progress at 25/50/75/100 percent.
  const openers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-hero-open]'));
  const dialog = document.querySelector<HTMLDialogElement>('[data-hero-dialog]');
  const full = document.querySelector<HTMLVideoElement>('[data-hero-full]');
  const close = document.querySelector<HTMLButtonElement>('[data-hero-close]');

  if (openers.length && dialog && full && close && typeof dialog.showModal === 'function') {
    function show() {
      dialog.showModal();
      full.currentTime = 0;
      full.muted = false;
      full.play().catch(() => {
        // Unmuted autoplay can be refused; fall back to muted so it still runs.
        full.muted = true;
        full.play().catch(() => {});
      });
    }
    function hide() {
      if (dialog.open) dialog.close();
    }

    openers.forEach((b) => b.addEventListener('click', show));
    close.addEventListener('click', hide);
    // Clicking the backdrop (outside the frame) closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) hide();
    });
    dialog.addEventListener('close', () => {
      full.pause();
    });

    const milestones = [25, 50, 75, 100];
    let reached = new Set<number>();
    full.addEventListener('play', () => {
      if (full.currentTime < 1) reached = new Set();
    });
    full.addEventListener('timeupdate', () => {
      if (!Number.isFinite(full.duration) || full.duration === 0) return;
      const pct = (full.currentTime / full.duration) * 100;
      for (const m of milestones) {
        if (pct >= m && !reached.has(m)) {
          reached.add(m);
          track('video_progress', { video: 'home-walkthrough', percent: m });
        }
      }
    });
    full.addEventListener('ended', () => {
      if (!reached.has(100)) {
        reached.add(100);
        track('video_progress', { video: 'home-walkthrough', percent: 100 });
      }
    });
  }
</script>
